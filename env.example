# ── Firebase Client SDK (public, safe to expose) ──────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Google Maps API Key (public) ───────────────────────────────────────────────
# Enable: Maps JavaScript API, Places API, Drawing Library
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Firebase Functions base URL (public) ───────────────────────────────────────
# Format: https://<region>-<project-id>.cloudfunctions.net/api
NEXT_PUBLIC_FUNCTIONS_BASE_URL=

# ── Firebase Auth emulator (public, local dev only) ────────────────────────────
# Set to "true" to point the client SDK at localhost emulators.
# NEXT_PUBLIC_USE_EMULATOR=

# ── Firebase Admin SDK (server-only, never expose to client) ───────────────────
# Option A: Service account JSON encoded as base64
FIREBASE_ADMIN_CREDENTIAL_BASE64=

# Option B: Individual fields (only if not using base64)
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# Option C (legacy): raw service account JSON as a single string
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Google Maps API Key (server-only — do NOT reuse the NEXT_PUBLIC one above) ──
# Places API only, application restrictions: None (Cloud Run has no stable outbound
# IP to restrict by — the API restriction is what scopes this key down).
# Used by admin/pitstop-finder's closed-at-night lookup; feature no-ops without it.
GOOGLE_MAPS_API_KEY=

# ── NREL API Key (server-only) ──────────────────────────────────────────────────
# Free instant registration: https://developer.nlr.gov/signup/
# Used by admin/charging-sites to query the AFDC charging station dataset.
# Required — no DEMO_KEY fallback. The shared demo key is rate-limited to ~30
# requests/hour per IP and looks like a working integration until it starts
# 429ing in production, so a missing key fails the search outright instead.
NREL_API_KEY=

# ── Firecrawl API Key (server-only) ─────────────────────────────────────────────
# Used by parking-sourcing scrapers (laz.ai, firecrawl extract client).
# Feature throws without it — sourcing scrapes are opt-in per run.
FIRECRAWL_API_KEY=
