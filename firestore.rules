rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // ── Parking Lots (BDR pipeline — admins only) ──────────────────────────
    match /parking_lots/{lotId} {
      allow read, write: if isAdmin();

      match /outreach/{outreachId} {
        allow read, write: if isAdmin();
      }
    }

    // ── Pit Stop Finder (site discovery — admins only) ─────────────────────
    match /pitstop_findings/{siteId} {
      allow read, write: if isAdmin();
    }

    // ── Pitstop Config (scoring weights + metro definitions) ───────────────
    match /pitstop_configs/{metro} {
      allow read, write: if isAdmin();
    }

    // ── Charging Sites (AFDC stations we track for BD) ─────────────────────
    match /charging_sites/{afdcId} {
      allow read, write: if isAdmin();
    }

    // ── Fleet Feedback (ML training data from fleet API) ──────────────────
    match /fleet_feedback/{feedbackId} {
      allow read, write: if isAdmin();
    }

    // ── Prospects (internal CRM — admins only) ────────────────────────────
    match /prospects/{prospectId} {
      allow read, write: if isAdmin();

      match /notes/{noteId} {
        allow read, write: if isAdmin();
      }
    }
  }
}